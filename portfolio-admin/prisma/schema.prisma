generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  excerpt   String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model Project {
  id          String @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  link        String?
}

model Activity {
  id           String   @id @default(cuid())
  stravaId     BigInt   @unique
  name         String
  type         String
  // Strava's finer-grained type (TrailRun, Run, Hike...); null on rows synced before it was captured
  sportType    String?
  distance     Float
  movingTime   Int
  elapsedTime  Int
  startDate    DateTime
  // Wall-clock start time in the athlete's timezone, stored as if it were UTC.
  // Used for bucketing into days/weeks so a 6am Monday run never lands in Sunday.
  startDateLocal DateTime?
  timezone     String?
  averageSpeed Float?
  maxSpeed     Float?
  elevation    Float?
  averageHeartrate Float?
  maxHeartrate     Float?
  // Training load (TRIMP-equivalent units), computed at ingest
  trainingLoad Float?

  // store raw streams
  streams      Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([startDate])
}

// Singleton (id = 1). Strava rotates refresh tokens, so they live here rather than in env.
model StravaAuth {
  id           Int      @id @default(1)
  athleteId    BigInt?
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

// Singleton (id = 1)
model AthleteProfile {
  id               Int      @id @default(1)
  maxHr            Int?
  restingHr        Int?
  // Banister TRIMP weighting: 1.92 (male) or 1.67 (female)
  trimpFactor      Float    @default(1.92)
  runDaysPerWeek   Int      @default(5)
  // 0 = Monday ... 6 = Sunday
  longRunDay       Int      @default(5)
  backToBack       Boolean  @default(true)
  maxWeeklyHours   Float?
  // IANA zone, e.g. "Australia/Melbourne". Null = infer from latest activity.
  timezone         String?
  // Free text (injuries, preferences) passed to the optional AI coach
  coachNotes       String?
  updatedAt        DateTime @default(now()) @updatedAt
}

model RaceEvent {
  id             String   @id @default(cuid())
  name           String
  date           DateTime @db.Date
  distanceKm     Float
  elevationGainM Float?
  // "A" = goal race (full taper), "B" = tune-up (mini taper), "C" = training race
  priority       String   @default("A")
  notes          String?
  createdAt      DateTime @default(now())

  @@index([date])
}

model PlanWeek {
  id               String   @id @default(cuid())
  // Monday of the week (athlete-local date)
  weekStart        DateTime @unique @db.Date
  phase            String
  targetHours      Float
  targetDistanceKm Float
  targetVertM      Float
  longRunMinutes   Int
  isDownWeek       Boolean  @default(false)
  targetRaceId     String?
  // JSON array of strings explaining the rule-based decisions
  rationale        Json
  aiNotes          String?
  aiNotesAt        DateTime?
  generatedAt      DateTime @default(now())
  workouts         PlannedWorkout[]
}

model PlannedWorkout {
  id              String   @id @default(cuid())
  planWeekId      String
  planWeek        PlanWeek @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  kind            String
  title           String
  description     String
  durationMinutes Int
  distanceKm      Float?
  vertM           Float?

  @@index([planWeekId])
}

// ---- Meal planning ----

// Anything that goes on a shopping list: recipe ingredients and household items alike
model GroceryItem {
  id              String   @id @default(cuid())
  name            String
  // Lowercased, whitespace-collapsed name; how "Ground cumin" in two recipes becomes one line
  nameKey         String   @unique
  category        String   @default("Other")
  // "weekly" = on every list, "occasional" = suggested with its last purchase date
  regular         String?
  regularQuantity String?
  // Usually in stock (salt, oil): listed under "check the pantry"
  pantry          Boolean  @default(false)
  lastPurchasedAt DateTime?
  createdAt       DateTime @default(now())
  recipeLines     RecipeIngredient[]
  listItems       ShoppingListItem[]
}

// One recipe = one night: dinner for two plus lunch the next day
model Recipe {
  id          String   @id @default(cuid())
  name        String
  notes       String?
  // Archived recipes stay on past weeks but aren't picked any more
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  ingredients RecipeIngredient[]
  nights      MealNight[]
}

model RecipeIngredient {
  id            String      @id @default(cuid())
  recipeId      String
  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  groceryItemId String
  groceryItem   GroceryItem @relation(fields: [groceryItemId], references: [id])
  quantity      Float?
  // One of the units in src/lib/meals/units.ts ("" = each)
  unit          String      @default("")
  note          String?
  position      Int         @default(0)

  @@index([recipeId])
  @@index([groceryItemId])
}

model MealWeek {
  id          String             @id @default(cuid())
  // Monday of the week
  weekStart   DateTime           @unique @db.Date
  confirmedAt DateTime?
  nights      MealNight[]
  listItems   ShoppingListItem[]
}

model MealNight {
  id         String   @id @default(cuid())
  mealWeekId String
  mealWeek   MealWeek @relation(fields: [mealWeekId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  // "recipe" or "out"
  kind       String
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
  note       String?

  @@unique([mealWeekId, date])
  @@index([recipeId])
}

// Snapshot of the list when a week is confirmed, so it doesn't shift as recipes are edited
model ShoppingListItem {
  id                      String       @id @default(cuid())
  mealWeekId              String
  mealWeek                MealWeek     @relation(fields: [mealWeekId], references: [id], onDelete: Cascade)
  groceryItemId           String?
  groceryItem             GroceryItem? @relation(fields: [groceryItemId], references: [id], onDelete: SetNull)
  name                    String
  quantity                String
  category                String
  // "recipe", "regular" or "extra" (added by hand)
  source                  String
  usedIn                  String[]
  pantry                  Boolean      @default(false)
  checkedAt               DateTime?
  // Restored to the item if the tick is undone
  previousLastPurchasedAt DateTime?

  @@index([mealWeekId])
}
